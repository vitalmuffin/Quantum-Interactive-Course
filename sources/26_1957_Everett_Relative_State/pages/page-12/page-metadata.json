      "topLeftY": 386,
      "bottomRightX": 603,
      "bottomRightY": 421,
      "content": "$$\\psi^{S_1}\\psi^{S_2}\\cdots\\psi^{S_n}\\psi^0_{[\\cdots]} \\rightarrow \\sum_i a_i \\phi_i^{S_1}\\psi^{S_2}\\cdots\\psi^{S_n}\\psi^0_{[\\cdots\\alpha_i]} \\quad (15)$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
