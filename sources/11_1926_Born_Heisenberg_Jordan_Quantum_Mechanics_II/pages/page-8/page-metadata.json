      "type": "text"
    },
    {
      "topLeftX": 269,
      "topLeftY": 752,
      "bottomRightX": 417,
      "bottomRightY": 787,
      "content": "$$PQ - QP = \\frac{h}{2\\pi i} 1$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
      "topLeftX": 103,
      "topLeftY": 793,
      "bottomRightX": 326,
      "bottomRightY": 811,
      "content": "ist, die kanonischen Gleichungen:",
