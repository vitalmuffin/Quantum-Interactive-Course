      "topLeftY": 816,
      "bottomRightX": 583,
      "bottomRightY": 853,
      "content": "$${}^1\\dot{Q} = \\frac{\\partial H}{\\partial P}, \\quad \\dot{P} = -\\frac{\\partial H}{\\partial Q}. \\quad (15)$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
