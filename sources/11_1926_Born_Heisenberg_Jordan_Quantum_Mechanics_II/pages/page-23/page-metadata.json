      "type": "text"
    },
    {
      "topLeftX": 102,
      "topLeftY": 238,
      "bottomRightX": 581,
      "bottomRightY": 277,
      "content": "Wir wollen nun den Einfluß beliebiger Störungen auf das entartete System untersuchen. Sei also",
      "confidenceScores": null,
      "type": "text"
    },
    {
