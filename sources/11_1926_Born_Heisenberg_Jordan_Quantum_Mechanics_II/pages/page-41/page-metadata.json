      "topLeftY": 834,
      "bottomRightX": 583,
      "bottomRightY": 874,
      "content": "$$\\left. \\begin{aligned} \\mathfrak{q}_{lx} M_x - M_z \\mathfrak{q}_{lx} &= -\\varepsilon \\mathfrak{q}_{ly}, \\\\ \\mathfrak{q}_{ly} M_x - M_z \\mathfrak{q}_{ly} &= \\varepsilon \\mathfrak{q}_{lx}, \\end{aligned} \\right\\} \\quad (6)$$",
      "confidenceScores": null,
      "type": "equation"
    },
