    },
    {
      "topLeftX": 135,
      "topLeftY": 250,
      "bottomRightX": 360,
      "bottomRightY": 268,
      "content": "The most general solution of (7) is:",
      "confidenceScores": null,
      "type": "text"
    },
    {
