      "bottomRightX": 605,
      "bottomRightY": 443,
      "content": "$$\\ddot{x} + \\omega_0^2 x + \\lambda x^3 = 0 \\quad . \\tag{52}$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
      "topLeftX": 152,
      "topLeftY": 456,
      "bottomRightX": 372,
      "bottomRightY": 472,
      "content": "Classically, we can set in this case:",
