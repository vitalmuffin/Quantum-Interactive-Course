      "topLeftX": 316,
      "topLeftY": 510,
      "bottomRightX": 749,
      "bottomRightY": 535,
      "content": "$$|\\overline{P}(\\vec{a}, \\vec{b}) + \\vec{a} \\cdot \\vec{b}| \\leq \\epsilon \\tag{16}$$",
