    },
    {
      "topLeftX": 263,
      "topLeftY": 710,
      "bottomRightX": 460,
      "bottomRightY": 752,
      "content": "$$S - S_0 = \\frac{E}{\\beta \\nu} \\lg \\left( \\frac{v}{v_0} \\right).$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
      "topLeftX": 80,
      "topLeftY": 756,
      "bottomRightX": 475,
      "bottomRightY": 780,
      "content": "Schreibt man diese Formel in der Gestalt:",
