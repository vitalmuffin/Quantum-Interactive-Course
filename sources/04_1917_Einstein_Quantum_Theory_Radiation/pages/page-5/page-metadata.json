    },
    {
      "topLeftX": 343,
      "topLeftY": 770,
      "bottomRightX": 658,
      "bottomRightY": 790,
      "content": "Also ist, ebenfalls in der gewünschten Näherung,",
      "confidenceScores": null,
      "type": "text"
    },
    {
