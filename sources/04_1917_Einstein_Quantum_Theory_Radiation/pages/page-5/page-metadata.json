    },
    {
      "topLeftX": 368,
      "topLeftY": 711,
      "bottomRightX": 658,
      "bottomRightY": 731,
      "content": "Aus (15) folgt mit entsprechender Näherung",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 419,
      "topLeftY": 734,
      "bottomRightX": 572,
      "bottomRightY": 766,
      "content": "$$v = v' (1 + \\frac{v}{c} \\cos \\varphi').$$",
      "confidenceScores": null,
