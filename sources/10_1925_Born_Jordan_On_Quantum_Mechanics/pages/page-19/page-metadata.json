    },
    {
      "topLeftX": 225,
      "topLeftY": 361,
      "bottomRightX": 586,
      "bottomRightY": 442,
      "content": "$$q = \\begin{pmatrix} 0 & q^{(01)} & 0 & 0 & 0 & \\dots \\\\ q^{(10)} & 0 & q^{(12)} & 0 & 0 & \\dots \\\\ 0 & q^{(21)} & 0 & q^{(23)} & 0 & \\dots \\\\ \\dots & \\dots & \\dots & \\dots & \\dots & \\dots \\end{pmatrix}. \\quad (53)$$",
