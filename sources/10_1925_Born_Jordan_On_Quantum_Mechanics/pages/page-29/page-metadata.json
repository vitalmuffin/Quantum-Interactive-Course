    },
    {
      "topLeftX": 294,
      "topLeftY": 770,
      "bottomRightX": 395,
      "bottomRightY": 804,
      "content": "$$\\frac{1}{r} e^{2\\pi i r \\left(t - \\frac{r}{c}\\right)}.$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
