    },
    {
      "topLeftX": 228,
      "topLeftY": 198,
      "bottomRightX": 459,
      "bottomRightY": 218,
      "content": "$$(n_k)' = n_{k+1} \\quad \\text{und} \\quad W_{k+1} > W_k$$",
