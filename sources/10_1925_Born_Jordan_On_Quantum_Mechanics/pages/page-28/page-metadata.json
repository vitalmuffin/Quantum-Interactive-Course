      "topLeftY": 794,
      "bottomRightX": 542,
      "bottomRightY": 829,
      "content": "$$\\frac{8\\pi}{c} \\mathcal{W} = (\\mathfrak{E}, \\text{rot } \\mathfrak{H}) + (\\text{rot } \\mathfrak{H}, \\mathfrak{E}) - (\\mathfrak{H}, \\text{rot } \\mathfrak{E}) - (\\text{rot } \\mathfrak{E}, \\mathfrak{H}),$$",
