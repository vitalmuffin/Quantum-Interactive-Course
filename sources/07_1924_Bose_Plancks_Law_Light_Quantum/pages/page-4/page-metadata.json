    {
      "topLeftX": 190,
      "topLeftY": 327,
      "bottomRightX": 498,
      "bottomRightY": 444,
      "content": "$$\\begin{aligned} N^s &= \\sum_r r p_r^s = \\sum_r r A^s \\left(1 - e^{-\\frac{h v^s}{\\beta}}\\right) e^{-\\frac{r h v^s}{\\beta}} \\\\ &= \\frac{A^s e^{-\\frac{h v^s}{\\beta}}}{1 - e^{-\\frac{h v^s}{\\beta}}}. \\end{aligned}$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
      "topLeftX": 105,
      "topLeftY": 453,
      "bottomRightX": 515,
      "bottomRightY": 473,
      "content": "Mit Rücksicht auf den oben gefundenen Wert von $A^s$ ist also",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 227,
      "topLeftY": 480,
      "bottomRightX": 466,
      "bottomRightY": 546,
      "content": "$$E = \\sum_s \\frac{8 \\pi h v^{s^3} d v^s}{c^3} V \\frac{e^{-\\frac{h v^s}{\\beta}}}{1 - e^{-\\frac{h v^s}{\\beta}}}.$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
      "topLeftX": 105,
      "topLeftY": 553,
      "bottomRightX": 491,
      "bottomRightY": 573,
      "content": "Mit Benutzung der bisherigen Resultate findet man ferner",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 230,
      "topLeftY": 579,
      "bottomRightX": 466,
      "bottomRightY": 622,
      "content": "$$S = k \\left[ \\frac{E}{\\beta} - \\sum_s A^s \\lg \\left(1 - e^{\\frac{h v^s}{\\beta}}\\right) \\right],$$",
      "confidenceScores": null,
      "type": "equation"
    },
    {
